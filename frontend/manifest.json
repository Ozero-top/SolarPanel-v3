{
  "name": "SolarPanel 导航面板",
  "short_name": "SolarPanel",
  "description": "自托管的书签导航 / 起始页面板，支持分组卡片、搜索引擎、天气、热点新闻与自定义 RSS。",
  "id": "./",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "zh-CN",
  "dir": "ltr",
  "theme_color": "#222734",
  "background_color": "#222734",
  "categories": ["productivity", "utilities", "bookmarks"],
  "share_target": {
    "action": "/clip-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "assets/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "保存链接",
      "short_name": "剪藏",
      "url": "clip"
    },
    {
      "name": "管理后台",
      "short_name": "管理",
      "url": "login.html?source=pwa"
    },
    {
      "name": "热点新闻",
      "short_name": "新闻",
      "url": "./?source=pwa#news"
    }
  ]
}
